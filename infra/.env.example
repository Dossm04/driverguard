# DriverGuard — пример переменных окружения.
# Скопируйте в infra/.env: cp infra/.env.example infra/.env

# --- PostgreSQL ---
POSTGRES_USER=driverguard
POSTGRES_PASSWORD=driverguard
POSTGRES_DB=driverguard
# Порт PostgreSQL на хосте (docker compose). Если 5432 занят локальным PostgreSQL или
# зарезервирован Windows/Hyper-V («forbidden by its access permissions») — поставьте 15432
DB_PORT=5432

# Строка подключения для backend (локальная разработка: postgres в docker, backend на хосте)
DATABASE_URL=postgresql+psycopg://driverguard:driverguard@localhost:5432/driverguard

# --- MinIO (S3-совместимое хранилище клипов и фото) ---
# Порт 9000 открыт в локальную сеть (телефоны открывают фото по presigned-ссылкам), поэтому
# пароль root должен быть сильным: make demo / make secrets-check FIX=1 заменят minioadmin
# (менять можно в любой момент: MinIO берёт root-креды из окружения при каждом старте)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
# Порт веб-консоли MinIO на хосте (docker compose)
MINIO_CONSOLE_PORT=9001
# Адрес MinIO, доступный из БРАУЗЕРА (для presigned-ссылок на клипы/фото)
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Регион MinIO для подписи ссылок (у стандартного MinIO — us-east-1)
MINIO_REGION=us-east-1

# ИИ-проверка чек-листов: auto — alem.ai при ключе, иначе Gemini при ключе, иначе демо-режим
# (вердикт «допущен» без анализа фото; в панели Настройки → Чек-лист видно, что ключ не задан)
AI_PROVIDER=auto
# alem.ai (OpenAI-совместимый, данные в Казахстане; ключ выдаётся на модель).
# Нужна модель, принимающая картинки: Gemma 4 (OPENAI_COMPAT_MODEL=gemma4); текстовые
# модели (KazLLM, AlemLLM, GPT OSS) для фото не подходят. Проверка: Настройки → Чек-лист → «Проверить ИИ»
OPENAI_COMPAT_BASE_URL=https://llm.alem.ai/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=gemma4
# Google Gemini (запасной провайдер)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Пусто — по умолчанию провайдера; low — быстрее, хуже калибровка confidence
GEMINI_THINKING_LEVEL=
MINIO_BUCKET_CLIPS=clips
MINIO_BUCKET_PHOTOS=photos

# --- Безопасность ---
# Секрет подписи JWT: backend НЕ СТАРТУЕТ с change-me/короткой строкой. make demo (или
# `make secrets-check FIX=1`) заменит на случайный; вручную: python3 -c 'import secrets;print(secrets.token_hex(32))'
JWT_SECRET=change-me
# Пароль admin@driverguard.kz и PIN демо-водителей при seed (пусто = admin123 / 1234 — только для
# локальной разработки; перед публичным стендом задайте свои: make tunnel откажется открывать
# туннель, пока действуют пароли по умолчанию)
ADMIN_PASSWORD=
DRIVER_PIN=
# Показывать демо-пароли на экранах входа в production-сборке (1) — не для публичного стенда
NEXT_PUBLIC_DEMO_HINTS=

# --- Внешние сервисы (заполняются при наличии ключей) ---
# Ключ Anthropic API для ИИ-функций (чек-листы и т.п.)
ANTHROPIC_API_KEY=
# Токен Telegram-бота для алертов координатору
TELEGRAM_BOT_TOKEN=
# ID чата/группы, куда бот шлёт алерты (запасной вариант; основной — панель → Настройки → Уведомления)
TELEGRAM_CHAT_ID=
# Служебная учётка бота в backend (создаётся seed'ом; review по кнопкам идёт от её имени)
BOT_EMAIL=bot@driverguard.kz
BOT_PASSWORD=bot12345
# Часовой пояс времени в сообщениях и ссылка на панель в алертах
TZ=Asia/Almaty
WEB_URL=http://localhost:3000
# Локальный/тестовый сервер Bot API (bot/scripts/fake_telegram.py); пусто = api.telegram.org
TELEGRAM_API_BASE=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live
# Подложка Live-карты: по умолчанию OpenStreetMap без ключа (тёмная тема — CSS-фильтр).
# Свой провайдер с ключом (CARTO, MapTiler, Stadia) — шаблон URL тайлов, например
# https://tiles.example.com/dark/{z}/{x}/{y}.png?key=…  (пусто = OpenStreetMap)
NEXT_PUBLIC_MAP_TILES_LIGHT=
NEXT_PUBLIC_MAP_TILES_DARK=
# WASM MediaPipe для PWA «Камера»: пусто — со своего сервера (/mediapipe/wasm); для показа
# 30–40 телефонам через туннель лучше CDN (make tunnel ставит сам):
# https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.35/wasm
NEXT_PUBLIC_MP_WASM_URL=

# --- Production-стандарты backend (docs/ARCHITECTURE.md) ---
LOG_LEVEL=INFO
LOG_FORMAT=text            # json — для сборщика логов
TRUST_PROXY=false          # true за Cloudflare Tunnel/nginx: клиентский IP из заголовков
RATE_LIMIT_AUTH_PER_MIN=120 # попыток входа с одного IP в минуту (зал на одном Wi-Fi — один IP)
RATE_LIMIT_PER_MIN=1200    # запросов на пользователя/IP в минуту
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
WORKER_THREADS=100

# Часовой пояс парка для границ «сегодня», графиков по дням и серий (backend)
APP_TZ=Asia/Almaty

# CORS backend: панель/PWA с другого адреса. По умолчанию разрешены localhost и вся локальная
# сеть (телефон открывает http://<IP-ноутбука>:3000); публичный домен добавьте сюда через запятую
CORS_ORIGINS=http://localhost:3000

# CORS: свой регэксп для нестандартных сетей (пусто = localhost и частные сети 192.168/10/172.16–31)
CORS_ORIGIN_REGEX=
# Симулятор движения машин на Live-карте (демо); false — только настоящие устройства и телефоны
DEMO_MODE=true

# Демо-стек (make demo): seed при пустой базе (auto) | пересеять (always) | не сеять (never)
SEED=auto
# Симулятор устройства в compose (сервис device-sim)
DG_SERIAL=DG-0001
DG_SECRET=device-secret-1   # секрет DG-0001 (seed + симулятор); менять ДО первого seed: secrets_check.py --fix --with-device
