PORT=3000
# Replace all three domains with the backend service's generated domain.
# Changing these variables requires a NEW BUILD, not only a restart.
NEXT_PUBLIC_API_URL=https://REPLACE_API_DOMAIN.up.railway.app/api/v1
NEXT_PUBLIC_WS_URL=wss://REPLACE_API_DOMAIN.up.railway.app/ws/live
INTERNAL_API_ORIGIN=https://REPLACE_API_DOMAIN.up.railway.app
NEXT_PUBLIC_DEMO_HINTS=0
NEXT_TELEMETRY_DISABLED=1
