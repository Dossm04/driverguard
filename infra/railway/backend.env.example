# Names below assume services named Postgres and Media in the same Railway project.
DATABASE_URL=${{Postgres.DATABASE_URL}}
PORT=8000
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
DG_BOOTSTRAP_ADMIN_EMAIL=admin@driverguard.kz
DG_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
DG_BOOTSTRAP_ADMIN_NAME=DriverGuard Coordinator
DG_BOOTSTRAP_DEPOT_NAME=Astana

MINIO_ENDPOINT=${{Media.ENDPOINT}}
MINIO_PUBLIC_ENDPOINT=${{Media.ENDPOINT}}
MINIO_ROOT_USER=${{Media.ACCESS_KEY_ID}}
MINIO_ROOT_PASSWORD=${{Media.SECRET_ACCESS_KEY}}
MINIO_REGION=${{Media.REGION}}
MINIO_BUCKET_PHOTOS=${{Media.BUCKET}}
MINIO_BUCKET_CLIPS=${{Media.BUCKET}}
MINIO_VIRTUAL_HOST_STYLE=true

# Replace with the web service's generated HTTPS origin, without a trailing slash.
CORS_ORIGINS=https://REPLACE_WEB_DOMAIN.up.railway.app
CORS_ORIGIN_REGEX=^$
DEMO_MODE=false
SEED=never
APP_TZ=Asia/Almaty
AI_PROVIDER=auto
LOG_FORMAT=json
LOG_LEVEL=INFO
TRUST_PROXY=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
WORKER_THREADS=20
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_PER_MIN=600
