# /etc/systemd/system/driverguard-simulate.service — демо без камеры (стенд / ментор-сессия)
[Unit]
Description=DriverGuard device simulator (no camera)
After=network-online.target

[Service]
Type=simple
User=driverguard
StateDirectory=driverguard
Environment=HOME=/var/lib/driverguard
WorkingDirectory=/var/lib/driverguard
EnvironmentFile=-/etc/driverguard/device.env
ExecStart=/opt/driverguard/device/.venv/bin/python -m dg --simulate --config /etc/driverguard/config.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
